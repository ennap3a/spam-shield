# --- Virtual environment (rebuilt from requirements.txt) ---
.venv/

# --- Python's automatic cache files ---
__pycache__/
*.pyc
.pytest_cache/

# --- Datasets (too large; downloaded separately) ---
# Ignore everything in these folders, EXCEPT the .gitkeep placeholder
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Trained models: ignored, EXCEPT the final model the app loads ---
models/*
!models/.gitkeep
!models/spam_shield_model.joblib

# --- Jupyter notebook autosave files ---
.ipynb_checkpoints/

# --- Secrets: NEVER commit these ---
.env

# --- Editor and operating-system files ---
.vscode/
Thumbs.db


*.egg-info/
.DS_Store
